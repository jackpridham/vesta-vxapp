[Unit]
Description=Vesta-managed Harbor registry
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/install -o 0 -g 0 -m 0770 -d /run/vesta-harbor
ExecStart=/usr/bin/docker compose --project-name vesta-harbor --file /usr/local/vesta/data/harbor/release/current/docker-compose.yml up --detach --remove-orphans
ExecStartPost=/usr/local/vesta/bin/v-sync-harbor-registry-owners
ExecStop=/usr/bin/docker compose --project-name vesta-harbor --file /usr/local/vesta/data/harbor/release/current/docker-compose.yml stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
