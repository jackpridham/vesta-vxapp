{
  "name": "restricted-compatibility",
  "version": 2,
  "enabled": true,
  "admin_only": true,
  "allow_build": false,
  "allow_bind_mounts": false,
  "allow_external_networks": false,
  "allow_public_ports": false,
  "allow_host_namespaces": false,
  "allowed_cap_add": [
    "CHOWN",
    "DAC_OVERRIDE",
    "KILL",
    "SETGID",
    "SETUID"
  ]
}
