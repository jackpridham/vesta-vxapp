#!/bin/bash
# info: revoke the exact owned Cloudflare Origin CA certificate for a managed site
# options: USER DOMAIN [FORMAT]


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

user=$1
domain=$2
format=${3:-human}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/cloudflare/main.sh"
source "$VESTA/conf/vesta.conf"


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args 2 "$#" 'USER DOMAIN [FORMAT]'
[[ $# -le 3 && ( "$format" == human || "$format" == json ) ]] \
    || check_result "$E_ARGS" 'invalid arguments'
is_format_valid user domain
is_object_valid user USER "$user"
is_object_unsuspended user USER "$user"


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

vx_cf_origin_cleanup "$user" "$domain" \
    || check_result "$E_CONNECT" "${VX_CF_STATUS:-provider_error}"
vx_cf_emit_status "$VX_CF_STATUS" "$format"


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"
exit
