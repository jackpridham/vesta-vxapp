#!/bin/bash
# info: rebuild docker containers
# options: USER
#
# The function re-applies managed docker container metadata for one user or all users.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source $VESTA/conf/vesta.conf
fi

rebuild_scope() {
    local owner="$1"
    local line

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        vx_docker_parse_record "$line"
        STATUS="$(vx_docker_runtime_state "$CTN_NAME")"
        UPDATED="$(vx_docker_now)"
        vx_docker_replace_record "$owner" "$NAME"
        if [ -n "$DOMAIN" ] && vx_docker_owner_domain_exists "$owner" "$DOMAIN"; then
            $BIN/v-sync-docker-container-route "$owner" "$NAME"
            check_result $? "docker route sync failed"
        fi
    done < <(vx_docker_list_owner_records "$owner")
}


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
ensure_docker_engine_available


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$user" = 'admin' ]; then
    for owner_dir in "$VESTA"/data/users/*; do
        [ -d "$owner_dir" ] || continue
        rebuild_scope "$(basename "$owner_dir")"
    done
else
    rebuild_scope "$user"
fi


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

log_history "rebuilt docker containers for $user"
log_event "$OK" "$ARGUMENTS"

exit
