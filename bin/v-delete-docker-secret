#!/bin/bash
# info: delete an unreferenced Compose project secret
# options: USER PROJECT NAME

user=$1
compose_project=$2
secret_name=$3

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '3' "$#" 'USER PROJECT NAME'
[ "$#" -le 3 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

vx_compose_secret_delete "$user" "$compose_project" "$secret_name" \
    || check_result "$E_INVALID" 'Compose secret deletion failed'

log_history "deleted Compose secret $compose_project/$secret_name"
log_event "$OK" "$ARGUMENTS"
exit
