#!/bin/bash
# info: stop docker container
# options: CONTAINER
#
# The function stops a docker container.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
container_name=$1

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source $VESTA/conf/vesta.conf
fi


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'CONTAINER'
ensure_docker_engine_available
ensure_docker_container_name_provided "$container_name"
ensure_docker_container_exists "$container_name"


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

docker stop "$container_name"


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit $?
