#!/bin/bash
# Vesta record helpers consume these globals across sourced functions.
# shellcheck disable=SC2034
# info: stop docker container
# options: USER NAME
#
# The function stops a managed docker container.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source $VESTA/conf/vesta.conf
fi


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER NAME'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
ensure_docker_engine_available
if vx_compose_require_project "$user" "$name" >/dev/null 2>&1; then
    vx_compose_stop "$user" "$name" \
        || check_result "$E_RESTART" 'Docker Compose project stop failed'
    log_history "stopped Docker Compose simple project $name"
    log_event "$OK" "$ARGUMENTS"
    exit
fi
vx_docker_load_record "$user" "$name" || check_result "$E_NOTEXIST" "docker container $name doesn't exist"
vx_docker_assert_runtime_labels_match "$user" "$name" "$CTN_NAME"


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

docker stop "$CTN_NAME" >/dev/null
check_result $? "docker stop failed"
STATUS='exited'
UPDATED="$(vx_docker_now)"
vx_docker_replace_record "$user" "$name"


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

log_history "stopped docker container $name"
log_event "$OK" "$ARGUMENTS"

exit
