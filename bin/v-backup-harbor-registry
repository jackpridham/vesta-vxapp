#!/bin/bash
# info: report that Harbor provider backup is deferred
# options:

VESTA=${VESTA:-/usr/local/vesta}
source "$VESTA/func/main.sh"
source "$VESTA/func/vx/harbor/main.sh"
source "$VESTA/conf/vesta.conf"
check_args '0' "$#" ''
echo 'Harbor provider backup and restore are deferred for this release.' >&2
exit "$VX_HARBOR_BACKUP_DEFERRED"
