#!/bin/bash
# info: list bounded Docker Compose project logs
# options: USER PROJECT [SERVICE] [LINES]

user=$1
compose_project=$2
service=${3-}
lines=${4-100}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '2' "$#" 'USER PROJECT [SERVICE] [LINES]'
[ "$#" -le 4 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_compose_logs "$user" "$compose_project" "$service" "$lines" \
    || check_result "$E_INVALID" 'Docker Compose log collection failed'
exit
