#!/bin/bash
# info: acknowledge docker container alert
# options: USER AID
#
# The function acknowledges a persisted docker alert.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
aid=$2

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
source $VESTA/conf/vesta.conf


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER AID'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_int_format_valid "$aid" 'alert id'


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

vx_docker_acknowledge_alert "$user" "$aid" || check_result "$E_NOTEXIST" "docker alert $aid doesn't exist"


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit
