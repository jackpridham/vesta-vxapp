#!/bin/bash
# info: list redacted Compose project secret metadata
# options: USER PROJECT [FORMAT]

user=$1
compose_project=$2
format=${3-shell}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '2' "$#" 'USER PROJECT [FORMAT]'
[ "$#" -le 3 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

secret_json="$(vx_compose_secret_list_json "$user" "$compose_project")" \
    || check_result "$E_INVALID" 'Compose secret listing failed'
case "$format" in
    json) printf '%s\n' "$secret_json" ;;
    shell|plain)
        jq -r 'to_entries[] |
            "\(.key) TARGET=\(.value.TARGET) ROTATED=\(.value.ROTATED)"' \
            <<<"$secret_json"
        ;;
    *) check_result "$E_INVALID" "invalid format :: $format" ;;
esac
exit
