#!/bin/bash
# info: verify immutable Docker image trust evidence
# options: USER IMAGE PROFILE [FORMAT]

user=$1
image=$2
profile=$3
format=${4-json}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '3' "$#" 'USER IMAGE PROFILE [FORMAT]'
[ "$#" -le 4 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_compose_profile_is_available "$profile" \
    || check_result "$E_INVALID" 'Docker Compose profile is unavailable'
vx_compose_image_reference_is_valid "$image" \
    || check_result "$E_INVALID" 'Docker image reference is invalid'
inspection="$(vx_compose_image_inspect "$user" "$image")" \
    || check_result "$E_INVALID" 'Docker image inspection failed'
immutable_reference="$(
    vx_compose_image_immutable_reference "$inspection" "$image"
)" || check_result "$E_INVALID" 'Docker image registry identity is invalid'
labels="$(vx_compose_image_oci_labels "$inspection")" \
    || check_result "$E_INVALID" 'Docker image labels are invalid'
result="$(vx_compose_verify_image_trust "$profile" "$immutable_reference" \
    "$(jq -r '.Id' <<<"$inspection")" "$labels")" \
    || check_result "$E_INVALID" 'Docker image trust verification failed'
case "$format" in
    json) printf '%s\n' "$result" ;;
    plain) jq -r '[.MODE,.DECISION,.PROFILE,.PROFILE_VERSION,
        .SIGNATURE.STATE,.VULNERABILITY.STATE]|@tsv' <<<"$result" ;;
    *) check_result "$E_INVALID" 'format must be json or plain' ;;
esac
exit
