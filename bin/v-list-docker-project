#!/bin/bash
# info: list Docker Compose project
# options: USER PROJECT [FORMAT]

user=$1
compose_project=$2
format=${3-shell}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi

check_args '2' "$#" 'USER PROJECT [FORMAT]'
[ "$#" -le 3 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
project_json="$(vx_compose_inspect_json "$user" "$compose_project")" \
    || check_result "$E_NOTEXIST" "Compose project does not exist :: $compose_project"

case "$format" in
    json) printf '%s\n' "$project_json" ;;
    plain)
        jq -r '[.OWNER,.PROJECT,.COMPOSE_PROJECT,.STATE,.PROFILE,(.REVISION|tostring),.UPDATED] | @tsv' \
            <<<"$project_json"
        ;;
    shell)
        jq -r '"OWNER:             " + .OWNER,
            "PROJECT:           " + .PROJECT,
            "COMPOSE PROJECT:   " + .COMPOSE_PROJECT,
            "STATE:             " + .STATE,
            "PROFILE:           " + .PROFILE,
            "REVISION:          " + (.REVISION|tostring),
            "UPDATED:           " + .UPDATED' <<<"$project_json"
        ;;
    *) check_result "$E_INVALID" "invalid format :: $format" ;;
esac

exit
