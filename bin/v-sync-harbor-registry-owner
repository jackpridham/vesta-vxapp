#!/bin/bash
# info: reconcile one Vesta owner's managed Harbor registry authority
# options: USER

user=${1:-}
source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
source "$VESTA/func/vx/harbor/main.sh"
source "$VESTA/conf/vesta.conf"
check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_harbor_owner_reconcile "$user"
check_result $? 'Harbor owner reconciliation failed'
log_history "synchronized Harbor registry owner $user" '' 'admin'
log_event "$OK" "$ARGUMENTS"
