#!/bin/bash
# info: delete docker container
# options: USER NAME
#
# The function removes a managed docker container.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source $VESTA/conf/vesta.conf
fi


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER NAME'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
ensure_docker_engine_available
if vx_compose_require_project "$user" "$name" >/dev/null 2>&1; then
    vx_compose_remove "$user" "$name" \
        || check_result "$E_UPDATE" 'Docker Compose project removal failed'
    log_history "deleted Docker Compose simple project $name and retained data"
    log_event "$OK" "$ARGUMENTS"
    exit
fi
vx_docker_load_record "$user" "$name" || check_result "$E_NOTEXIST" "docker container $name doesn't exist"
if docker container inspect "$CTN_NAME" >/dev/null 2>&1; then
    vx_docker_assert_runtime_labels_match "$user" "$name" "$CTN_NAME"
fi


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ -n "$DOMAIN" ]; then
    if vx_docker_domain_matches_target "$user" "$DOMAIN" "$HOST_PORT"; then
        $BIN/v-delete-web-domain-proxy "$user" "$DOMAIN" no >/dev/null
        check_result $? "docker route removal failed"
    fi
fi
vx_docker_remove_runtime_if_present "$CTN_NAME"
check_result $? "docker delete failed"
vx_docker_remove_bind_root "$user" "$name"
vx_docker_delete_record "$user" "$name"
vx_docker_adjust_user_counter "$user" decrease


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

log_history "deleted docker container $name"
log_event "$OK" "$ARGUMENTS"

exit
