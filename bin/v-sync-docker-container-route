#!/bin/bash
# info: sync docker container route
# options: USER NAME
#
# The function applies the linked web-domain proxy target for a managed docker container.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source $VESTA/conf/vesta.conf
fi


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER NAME'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_docker_load_record "$user" "$name" || check_result "$E_NOTEXIST" "docker container $name doesn't exist"


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

[ -n "$DOMAIN" ] || exit 0
if ! vx_docker_owner_domain_exists "$user" "$DOMAIN"; then
    check_result "$E_NOTEXIST" "web domain $DOMAIN doesn't exist"
fi

$BIN/v-change-web-domain-proxy-options "$user" "$DOMAIN" \
    'proxy' "http://127.0.0.1:${HOST_PORT}" 'application' 'yes' '60' '' no >/dev/null
check_result $? "docker proxy route sync failed"


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

log_history "synced docker container route for $name"
log_event "$OK" "$ARGUMENTS"

exit
