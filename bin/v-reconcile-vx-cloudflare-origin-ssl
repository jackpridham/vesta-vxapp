#!/bin/bash
# info: issue and install the exact Cloudflare Origin CA certificate for a managed site
# options: USER DOMAIN [RESTART] [FORMAT]


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

user=$1
domain=$2
restart=${3:-yes}
format=${4:-human}

source "$VESTA/func/main.sh"
source "$VESTA/func/domain.sh"
source "$VESTA/func/vx/cloudflare/main.sh"
source "$VESTA/conf/vesta.conf"


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args 2 "$#" 'USER DOMAIN [RESTART] [FORMAT]'
[[ $# -le 4 && ( "$format" == human || "$format" == json ) ]] \
    || check_result "$E_ARGS" 'invalid arguments'
is_format_valid user domain
is_object_valid user USER "$user"
is_object_unsuspended user USER "$user"
is_object_valid web DOMAIN "$domain"
is_object_unsuspended web DOMAIN "$domain"


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

vx_cf_origin_reconcile "$user" "$domain" "$restart" \
    || check_result "$E_CONNECT" "${VX_CF_STATUS:-certificate_error}"
vx_cf_emit_status "$VX_CF_STATUS" "$format"


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

log_history "reconciled managed origin certificate for $domain"
log_event "$OK" "$ARGUMENTS"
exit
