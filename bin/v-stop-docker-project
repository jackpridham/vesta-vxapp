#!/bin/bash
# info: stop Docker Compose project
# options: USER PROJECT

user=$1
compose_project=$2

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi

check_args '2' "$#" 'USER PROJECT'
[ "$#" -le 2 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_compose_stop "$user" "$compose_project" \
    || check_result "$E_RESTART" 'Docker Compose project stop failed'

log_history "stopped Docker Compose project $compose_project"
log_event "$OK" "$ARGUMENTS"
exit
