#!/bin/bash
# info: deploy Docker Compose project
# options: USER PROJECT
#
# Converges the validated project and waits for health.

user=$1
compose_project=$2

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi

check_args '2' "$#" 'USER PROJECT'
[ "$#" -le 2 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
vx_compose_deploy "$user" "$compose_project" \
    || check_result "$E_UPDATE" 'Docker Compose project deployment failed'

log_history "deployed Docker Compose project $compose_project"
log_event "$OK" "$ARGUMENTS"
exit
