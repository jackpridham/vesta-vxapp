#!/bin/bash
# info: update system queue
# options: PIPE
#
# This function is responsible queue processing. Restarts of services,
# scheduled backups, web log parsing and other heavy resource consuming
# operations are handled by this script. It helps to optimize system behaviour.
# In a nutshell Apache will be restarted only once even if 10 domains are
# added or deleted.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#
# Argument definition
queue=$1

# Importing system environment  as we run this script
# mostly by cron wich not read it by itself
source /etc/profile

# Includes
source $VESTA/func/main.sh
source $VESTA/conf/vesta.conf

# Export PATH for cron
PATH=$PATH:$BIN


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'QUEUE'


case $queue in
    restart|webstats|backup|disk|traffic|dns-cluster|letsencrypt) ;;
    *)              check_args '1' '0' 'QUEUE' ;;
esac


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Serialize each queue. A slow queue must never overlap with the next cron
# invocation and replay the same pending work concurrently.
queue_file="$VESTA/data/queue/$queue.pipe"
lock_file="$VESTA/data/queue/$queue.lock"
touch "$lock_file"
chmod 600 "$lock_file"
exec 9>"$lock_file"
if ! flock -n 9; then
    exit
fi

bash "$queue_file" > /dev/null 2>&1

if [ "$queue" = "disk" ]; then
    if [ ! -d "/usr/local/vesta/data/df" ]; then
        mkdir -p /usr/local/vesta/data/df
    fi

    du -sm /var/log/ | awk '{print $1}' > /usr/local/vesta/data/df/var-log-size.txt 2>/dev/null

    if [ -d "/backup" ]; then
        du -sm /backup/ | awk '{print $1}' > /usr/local/vesta/data/df/backup-size.txt 2>/dev/null
    else
        echo "0" > /usr/local/vesta/data/df/backup-size.txt
    fi

    /usr/local/vesta/bin/v-clean-garbage-calculate -q > /dev/null 2>&1

    if [ -e "/root/myvesta-custom-df-count" ]; then
        /root/myvesta-custom-df-count
    fi
fi

#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

# No Logging
#log_event "$OK" "$ARGUMENTS"

exit
