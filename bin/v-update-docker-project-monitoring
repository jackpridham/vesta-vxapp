#!/bin/bash
# info: update Docker Compose project health, metrics, and alerts
# options: USER PROJECT

user=$1
compose_project=$2

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '2' "$#" 'USER PROJECT'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_compose_monitor_project "$user" "$compose_project" \
    || check_result "$E_INVALID" 'Docker Compose monitoring update failed'
exit
