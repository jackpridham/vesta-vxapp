#!/bin/bash
# info: grant a fine-grained Docker Compose project role
# options: ACTOR USER PROJECT SUBJECT ROLE

compose_actor=$1
user=$2
compose_project=$3
subject=$4
role=$5

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '5' "$#" 'ACTOR USER PROJECT SUBJECT ROLE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_compose_role_set "$compose_actor" "$user" "$compose_project" "$subject" "$role" \
    || check_result "$E_INVALID" 'Compose project role grant failed'
log_history "granted Compose project role $compose_project/$subject"
log_event "$OK" "$ARGUMENTS"
exit
