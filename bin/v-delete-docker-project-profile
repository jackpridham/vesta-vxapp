#!/bin/bash
# info: delete an administrator Docker Compose profile assignment
# options: USER PROJECT

user=$1
compose_project=$2

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '2' "$#" 'USER PROJECT'
[ "$#" -le 2 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
vx_compose_profile_assignment_delete "$user" "$compose_project" \
    || check_result "$E_INVALID" \
        'Docker Compose profile assignment deletion failed'

log_history "deleted Docker Compose profile assignment for $compose_project"
log_event "$OK" "$ARGUMENTS"
exit
