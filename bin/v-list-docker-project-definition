#!/bin/bash
# info: list the validated stored Docker Compose project definition
# options: USER PROJECT FORMAT
user=$1
compose_project=$2
format=${3-json}
source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
check_args '2' "$#" 'USER PROJECT FORMAT'
[ "$#" -le 3 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
[[ "$format" == json ]] \
    || check_result "$E_INVALID" 'definition output format must be json'
vx_compose_definition_export_json "$user" "$compose_project" \
    || check_result "$E_INVALID" 'Compose definition export failed'
