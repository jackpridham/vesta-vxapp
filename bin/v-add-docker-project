#!/bin/bash
# info: add Docker Compose project
# options: USER PROJECT COMPOSE_FILE [PROFILE]
#
# Persists a validated Compose project without starting it.

user=$1
compose_project=$2
compose_file=$3
profile=${4-standard}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi

check_args '3' "$#" 'USER PROJECT COMPOSE_FILE [PROFILE]'
[ "$#" -le 4 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
vx_compose_require_project_key "$compose_project" \
    || check_result "$E_INVALID" "invalid Compose project :: $compose_project"
vx_compose_profile_is_available "$profile" \
    || check_result "$E_INVALID" "Compose profile is not available :: $profile"

candidate_parent="$(mktemp -d)"
candidate="$candidate_parent/candidate"
trap 'rm -rf -- "$candidate_parent"' EXIT
vx_compose_prepare_candidate "$user" "$compose_project" "$compose_file" "$candidate" \
    || check_result "$E_INVALID" 'Compose project validation failed'
vx_compose_store_new "$user" "$compose_project" "$profile" "$candidate" \
    || check_result "$E_INVALID" 'Compose project persistence failed'

log_history "added Docker Compose project $compose_project"
log_event "$OK" "$ARGUMENTS"
exit
