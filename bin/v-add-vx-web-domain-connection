#!/bin/bash
# info: create a pending native customer-domain connection
# options: USER TECHNICAL_FQDN HOSTNAME REQUEST_ID [json]

# Variable&Function
user=$1; technical=$2; hostname=$3; request_id=$4; format=${5-shell}
[[ $EUID == 0 ]] || { echo "Error: root authority required" >&2; exit 10; }
source "$VESTA/func/main.sh"
source "$VESTA/conf/vesta.conf"
source "$VESTA/func/vx/domain-connections/main.sh"
# Verifications
check_args 4 "$#" 'USER TECHNICAL_FQDN HOSTNAME REQUEST_ID [json]'; [ "$#" -le 5 ] || check_result "$E_ARGS" 'too many arguments'
domain=$technical
is_format_valid user domain; is_object_valid user USER "$user"
technical=$(vx_domain_connection_canonical_hostname "$technical") || check_result "$E_INVALID" 'invalid technical hostname'
[[ "$format" == json || "$format" == shell ]] || check_result "$E_INVALID" 'invalid format'
# Action
record="$(vx_domain_connection_create "$user" "$technical" "$hostname" "$request_id")" || {
    result=$?
    case "$result" in
        10) result=$E_EXISTS; error_code=hostname_conflict;;
        11) result=$E_LIMIT; error_code=quota_exceeded;;
        12) result=$E_DISABLED; error_code=enrollment_disabled;;
        13) result=$E_LIMIT; error_code=native_failure;;
        14) result=$E_DISABLED; error_code=native_failure;;
        *) result=$E_INVALID; error_code=native_failure;;
    esac
    if [[ "$format" == json ]]; then
        printf '{"version":1,"error":{"code":"%s","exitCode":%s}}\n' "$error_code" "$result"
        SILENT_MODE=yes
    fi
    check_result "$result" 'unable to create domain connection'
}
case "$format" in json) vx_domain_connection_public_json "$record";; shell) vx_domain_connection_public_json "$record" | /usr/bin/jq -r '.connection | "CONNECTION_ID=\(.connectionID) STATE=\(.state) HOSTNAME=\(.hostname)"';; *) check_result "$E_INVALID" 'invalid format';; esac
log_history "$(basename "$0") $technical $(jq -r .CONNECTION_ID <<<"$record")"
log_event "$OK" "$ARGUMENTS"
# Vesta
exit
