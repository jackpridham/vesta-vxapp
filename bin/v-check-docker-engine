#!/bin/bash
# info: check docker engine availability
# options: [FORMAT]
#
# The function checks whether docker is available on the host.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
source "$VESTA/func/main.sh"
source "$VESTA/func/docker.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if command -v docker >/dev/null 2>&1; then
    state='yes'
else
    state='no'
fi

if [ "$state" = 'yes' ] && docker info >/dev/null 2>&1; then
    daemon_state='yes'
else
    daemon_state='no'
fi

if [ "$state" = 'yes' ] && docker compose version >/dev/null 2>&1; then
    compose_state='yes'
else
    compose_state='no'
fi

if command -v jq >/dev/null 2>&1 && jq --version >/dev/null 2>&1; then
    jq_state='yes'
else
    jq_state='no'
fi

if command -v age >/dev/null 2>&1 && age --version >/dev/null 2>&1; then
    age_state='yes'
else
    age_state='no'
fi

if command -v python3 >/dev/null 2>&1 \
    && python3 --version >/dev/null 2>&1; then
    python3_state='yes'
else
    python3_state='no'
fi

if [ "$state" = 'yes' ] \
    && [ "$daemon_state" = 'yes' ] \
    && [ "$compose_state" = 'yes' ] \
    && [ "$jq_state" = 'yes' ] \
    && [ "$age_state" = 'yes' ] \
    && [ "$python3_state" = 'yes' ]; then
    orchestration_state='yes'
else
    orchestration_state='no'
fi

case "$format" in
    json)
        echo '{'
        echo '    "DOCKER_AVAILABLE": "'$state'"'
        echo '    ,"DOCKER_DAEMON_AVAILABLE": "'$daemon_state'"'
        echo '    ,"DOCKER_COMPOSE_AVAILABLE": "'$compose_state'"'
        echo '    ,"JQ_AVAILABLE": "'$jq_state'"'
        echo '    ,"AGE_AVAILABLE": "'$age_state'"'
        echo '    ,"PYTHON3_AVAILABLE": "'$python3_state'"'
        echo '    ,"DOCKER_ORCHESTRATION_READY": "'$orchestration_state'"'
        echo '}'
        ;;
    shell|plain)
        echo "$state"
        ;;
    *)
        check_result "$E_INVALID" "invalid format :: $format" "$E_INVALID"
        ;;
esac


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit
