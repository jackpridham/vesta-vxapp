#!/bin/bash
# info: check docker engine availability
# options: [FORMAT]
#
# The function checks whether docker is available on the host.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
source "$VESTA/func/main.sh"
source "$VESTA/func/docker.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if command -v docker >/dev/null 2>&1; then
    state='yes'
else
    state='no'
fi

if [ "$state" = 'yes' ] && docker info >/dev/null 2>&1; then
    daemon_state='yes'
else
    daemon_state='no'
fi

case "$format" in
    json)
        echo '{'
        echo '    "DOCKER_AVAILABLE": "'$state'"'
        echo '    ,"DOCKER_DAEMON_AVAILABLE": "'$daemon_state'"'
        echo '}'
        ;;
    shell|plain)
        echo "$state"
        ;;
    *)
        check_result "$E_INVALID" "invalid format :: $format" "$E_INVALID"
        ;;
esac


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit
