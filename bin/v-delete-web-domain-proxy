#!/bin/bash
# info: deleting web domain proxy configuration
# options: USER DOMAIN
#
# The function of deleting the virtualhost proxy configuration.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
restart=$3

# Includes
source $VESTA/func/main.sh
source $VESTA/func/domain.sh
source $VESTA/func/ip.sh
source $VESTA/func/vx/proxy.sh
source "$VESTA/func/vx/compose/routes.sh"
source $VESTA/conf/vesta.conf

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_system_enabled "$PROXY_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_object_value_exist 'web' 'DOMAIN' "$domain" '$PROXY'
compose_route_project="$(vx_compose_domain_route_project "$user" "$domain" 2>/dev/null)"
if [ -n "$compose_route_project" ] && [ "${VX_COMPOSE_SYNC_ROUTE-}" != 'yes' ]; then
    check_result "$E_FORBIDEN" \
        "web domain $domain proxy target is managed by Compose project $compose_route_project"
fi


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Defining domain parameters
get_domain_values 'web'
deleted_proxy="$PROXY"
del_web_config "$PROXY_SYSTEM" "$PROXY.tpl"

# Checking SSL
if [ "$SSL" = 'yes' ]; then
    del_web_config "$PROXY_SYSTEM" "$PROXY.stpl"
fi

# Native reverse-proxy support replaces the ordinary Vesta frontend template.
# Restore that template when the native target is disabled so both HTTP and
# HTTPS return to the domain's normal public_html-backed web vhost.
restored_proxy=''
restored_proxy_ext=''
if [ "$deleted_proxy" = "$VX_PROXY_TEMPLATE" ]; then
    restored_proxy=$(get_user_value '$PROXY_TEMPLATE')
    if [ -n "$restored_proxy" ] && [ "$restored_proxy" != "$VX_PROXY_TEMPLATE" ]; then
        is_proxy_template_valid "$restored_proxy"
        restored_proxy_ext="jpg,jpeg,gif,png,ico,svg,css,zip,tgz,gz,rar,bz2,doc,xls,exe,pdf,ppt,txt,odt,ods,odp,odf,tar,wav,bmp,rtf,js,mp3,avi,mpeg,flv,woff,woff2"
        PROXY_EXT="$restored_proxy_ext"
        prepare_web_domain_values
        local_ip=$(get_real_ip $IP)
        add_web_config "$PROXY_SYSTEM" "$restored_proxy.tpl"
        if [ "$SSL" = 'yes' ]; then
            add_web_config "$PROXY_SYSTEM" "$restored_proxy.stpl"
        fi
    fi
fi


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

# Update config
update_object_value 'web' 'DOMAIN' "$domain" '$PROXY' "$restored_proxy"
update_object_value 'web' 'DOMAIN' "$domain" '$PROXY_EXT' "$restored_proxy_ext"
vx_proxy_clear_web_conf

# Restart proxy server
$BIN/v-restart-proxy $restart
check_result $? "Proxy restart failed" >/dev/null

# Logging
log_history "disabled proxy support for $domain"
log_event "$OK" "$ARGUMENTS"

exit
