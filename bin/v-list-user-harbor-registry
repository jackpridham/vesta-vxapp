#!/bin/bash
# info: list one owner's redacted managed registry discovery
# options: USER PROJECT [FORMAT]

user=${1:-}; project=${2:-}; format=${3:-json}
VESTA=${VESTA:-/usr/local/vesta}
source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
source "$VESTA/func/vx/harbor/main.sh"
source "$VESTA/conf/vesta.conf"
check_args '2' "$#" 'USER PROJECT [FORMAT]'; is_format_valid 'user' 'project'; is_object_valid 'user' 'USER' "$user"
[[ "$format" == json || "$format" == plain ]]; check_result $? 'Invalid format'
vx_compose_require_profile "$user" "$project" standard; check_result $? 'Standard project required'
vx_harbor_provider_lock_acquire shared; check_result $? 'Harbor provider lock failed'; vx_compose_shell_access_lock_acquire "$user"; check_result $? 'Owner lock failed'; vx_compose_registry_lock_acquire "$user"; check_result $? 'Registry lock failed'
trap 'vx_compose_registry_lock_release; vx_compose_shell_access_lock_release; vx_harbor_provider_lock_release' EXIT
vx_harbor_owner_is_eligible "$user"; check_result $? 'Owner is not registry eligible'
vx_compose_require_profile "$user" "$project" standard; check_result $? 'Standard project required'
result="$(vx_harbor_registry_info_json "$user" "$project")"; check_result $? 'Registry discovery unavailable'
if [[ "$format" == json ]]; then /usr/bin/jq -cS . <<<"$result"; else /usr/bin/jq -r '[.MANAGED,.STATE,(.REGISTRY//""),(.NAMESPACE//""),(.REPOSITORY//""),(.PUBLISHER_USERNAME//""),.PUBLISHER_ENABLED,(.QUOTA_MB|tostring),(.USED_MB|tostring),.HEALTH,(.OBSERVED_AT//""),.FRESHNESS]|@tsv' <<<"$result"; fi
