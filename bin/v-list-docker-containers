#!/bin/bash
# info: list docker containers
# options: [USER] [FORMAT]
#
# The function lists managed docker containers from metadata.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

if [ -z "$user" ]; then
    user='admin'
    format='shell'
elif [ -z "$2" ] && { [ "$1" = 'json' ] || [ "$1" = 'plain' ] || [ "$1" = 'csv' ] || [ "$1" = 'shell' ]; }; then
    format="$1"
    user='admin'
fi

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source $VESTA/conf/vesta.conf
fi

vx_docker_list_records_for_scope() {
    if [ "$1" = 'admin' ]; then
        vx_docker_list_all_records
    else
        vx_docker_list_owner_records "$1"
    fi
}

record_count() {
    local count=0
    local line

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        count=$((count + 1))
    done < <(vx_docker_list_records_for_scope "$user")

    echo "$count"
}

json_list() {
    local total current line key

    total="$(record_count)"
    current=0
    echo '{'
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        current=$((current + 1))
        vx_docker_parse_record "$line"
        key="$(vx_docker_json_escape "$CTN_NAME")"
        printf '    "%s": {\n' "$key"
        printf '        "NAME": "%s",\n' "$(vx_docker_json_escape "$NAME")"
        printf '        "CTN_NAME": "%s",\n' "$(vx_docker_json_escape "$CTN_NAME")"
        printf '        "OWNER": "%s",\n' "$(vx_docker_json_escape "$OWNER")"
        printf '        "IMAGE": "%s",\n' "$(vx_docker_json_escape "$IMAGE")"
        printf '        "HOST_PORT": "%s",\n' "$(vx_docker_json_escape "$HOST_PORT")"
        printf '        "CONTAINER_PORT": "%s",\n' "$(vx_docker_json_escape "$CONTAINER_PORT")"
        printf '        "DOMAIN": "%s",\n' "$(vx_docker_json_escape "$DOMAIN")"
        printf '        "ROUTE_PATH": "%s",\n' "$(vx_docker_json_escape "$ROUTE_PATH")"
        printf '        "PROXY_MODE": "%s",\n' "$(vx_docker_json_escape "$PROXY_MODE")"
        printf '        "PROXY_TARGET": "%s",\n' "$(vx_docker_json_escape "$PROXY_TARGET")"
        printf '        "AUTO_START": "%s",\n' "$(vx_docker_json_escape "$AUTO_START")"
        printf '        "RESTART_POLICY": "%s",\n' "$(vx_docker_json_escape "$RESTART_POLICY")"
        printf '        "HEALTHCHECK_TYPE": "%s",\n' "$(vx_docker_json_escape "$HEALTHCHECK_TYPE")"
        printf '        "HEALTHCHECK_TARGET": "%s",\n' "$(vx_docker_json_escape "$HEALTHCHECK_TARGET")"
        printf '        "HEALTHCHECK_INTERVAL": "%s",\n' "$(vx_docker_json_escape "$HEALTHCHECK_INTERVAL")"
        printf '        "HEALTH_STATUS": "%s",\n' "$(vx_docker_json_escape "$HEALTH_STATUS")"
        printf '        "CPU_ALERT_PCT": "%s",\n' "$(vx_docker_json_escape "$CPU_ALERT_PCT")"
        printf '        "MEM_ALERT_MB": "%s",\n' "$(vx_docker_json_escape "$MEM_ALERT_MB")"
        printf '        "NET_ALERT_MBPS": "%s",\n' "$(vx_docker_json_escape "$NET_ALERT_MBPS")"
        printf '        "ALERT_EMAIL": "%s",\n' "$(vx_docker_json_escape "$ALERT_EMAIL")"
        printf '        "STATUS": "%s",\n' "$(vx_docker_json_escape "$STATUS")"
        printf '        "UPDATED": "%s"\n' "$(vx_docker_json_escape "$UPDATED")"
        printf '    }'
        if [ "$current" -lt "$total" ]; then
            echo ','
        else
            echo
        fi
    done < <(vx_docker_list_records_for_scope "$user")
    echo '}'
}

shell_list() {
    local line

    echo "OWNER NAME CTN_NAME STATUS IMAGE HOST_PORT DOMAIN HEALTH UPDATED"
    echo "----- ---- -------- ------ ----- -------- ------ ------ -------"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        vx_docker_parse_record "$line"
        echo "$OWNER $NAME $CTN_NAME $STATUS $IMAGE $HOST_PORT $DOMAIN $HEALTH_STATUS $UPDATED"
    done < <(vx_docker_list_records_for_scope "$user")
}

plain_list() {
    local line

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        vx_docker_parse_record "$line"
        echo -e "$OWNER\t$NAME\t$CTN_NAME\t$STATUS\t$IMAGE\t$HOST_PORT\t$CONTAINER_PORT\t$DOMAIN\t$ROUTE_PATH\t$PROXY_MODE\t$PROXY_TARGET\t$HEALTH_STATUS\t$UPDATED"
    done < <(vx_docker_list_records_for_scope "$user")
}

csv_list() {
    local line

    echo "OWNER,NAME,CTN_NAME,STATUS,IMAGE,HOST_PORT,CONTAINER_PORT,DOMAIN,ROUTE_PATH,PROXY_MODE,PROXY_TARGET,HEALTH_STATUS,UPDATED"
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        vx_docker_parse_record "$line"
        echo "\"$OWNER\",\"$NAME\",\"$CTN_NAME\",\"$STATUS\",\"$IMAGE\",\"$HOST_PORT\",\"$CONTAINER_PORT\",\"$DOMAIN\",\"$ROUTE_PATH\",\"$PROXY_MODE\",\"$PROXY_TARGET\",\"$HEALTH_STATUS\",\"$UPDATED\""
    done < <(vx_docker_list_records_for_scope "$user")
}


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '0' "$#" '[USER] [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

case "$format" in
    json)  json_list ;;
    plain) plain_list ;;
    csv)   csv_list ;;
    shell) shell_list | column -t ;;
    *)     check_result "$E_INVALID" "invalid format :: $format" "$E_INVALID" ;;
esac


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit
