#!/bin/bash
# info: list docker container parameters
# options: USER NAME [FORMAT]
#
# The function lists one managed docker container by owner and name.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
format=${3-shell}

# Includes
source $VESTA/func/main.sh
source $VESTA/func/docker.sh
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source $VESTA/conf/vesta.conf
fi

json_list() {
    printf '{\n'
    printf '    "%s": {\n' "$(vx_docker_json_escape "$NAME")"
    printf '        "NAME": "%s",\n' "$(vx_docker_json_escape "$NAME")"
    printf '        "CTN_NAME": "%s",\n' "$(vx_docker_json_escape "$CTN_NAME")"
    printf '        "OWNER": "%s",\n' "$(vx_docker_json_escape "$OWNER")"
    printf '        "IMAGE": "%s",\n' "$(vx_docker_json_escape "$IMAGE")"
    printf '        "COMMAND": "%s",\n' "$(vx_docker_json_escape "$COMMAND")"
    printf '        "ENV": "%s",\n' "$(vx_docker_json_escape "$ENV")"
    printf '        "MOUNTS": "%s",\n' "$(vx_docker_json_escape "$MOUNTS")"
    printf '        "HOST_PORT": "%s",\n' "$(vx_docker_json_escape "$HOST_PORT")"
    printf '        "CONTAINER_PORT": "%s",\n' "$(vx_docker_json_escape "$CONTAINER_PORT")"
    printf '        "DOMAIN": "%s",\n' "$(vx_docker_json_escape "$DOMAIN")"
    printf '        "ROUTE_PATH": "%s",\n' "$(vx_docker_json_escape "$ROUTE_PATH")"
    printf '        "PROXY_MODE": "%s",\n' "$(vx_docker_json_escape "$PROXY_MODE")"
    printf '        "PROXY_TARGET": "%s",\n' "$(vx_docker_json_escape "$PROXY_TARGET")"
    printf '        "AUTO_START": "%s",\n' "$(vx_docker_json_escape "$AUTO_START")"
    printf '        "RESTART_POLICY": "%s",\n' "$(vx_docker_json_escape "$RESTART_POLICY")"
    printf '        "HEALTHCHECK_TYPE": "%s",\n' "$(vx_docker_json_escape "$HEALTHCHECK_TYPE")"
    printf '        "HEALTHCHECK_TARGET": "%s",\n' "$(vx_docker_json_escape "$HEALTHCHECK_TARGET")"
    printf '        "HEALTHCHECK_INTERVAL": "%s",\n' "$(vx_docker_json_escape "$HEALTHCHECK_INTERVAL")"
    printf '        "HEALTH_STATUS": "%s",\n' "$(vx_docker_json_escape "$HEALTH_STATUS")"
    printf '        "LAST_HEALTH_AT": "%s",\n' "$(vx_docker_json_escape "$LAST_HEALTH_AT")"
    printf '        "CPU_ALERT_PCT": "%s",\n' "$(vx_docker_json_escape "$CPU_ALERT_PCT")"
    printf '        "MEM_ALERT_MB": "%s",\n' "$(vx_docker_json_escape "$MEM_ALERT_MB")"
    printf '        "NET_ALERT_MBPS": "%s",\n' "$(vx_docker_json_escape "$NET_ALERT_MBPS")"
    printf '        "ALERT_EMAIL": "%s",\n' "$(vx_docker_json_escape "$ALERT_EMAIL")"
    printf '        "STATUS": "%s",\n' "$(vx_docker_json_escape "$STATUS")"
    printf '        "CREATED": "%s",\n' "$(vx_docker_json_escape "$CREATED")"
    printf '        "UPDATED": "%s"\n' "$(vx_docker_json_escape "$UPDATED")"
    printf '    }\n'
    printf '}\n'
}

shell_list() {
    echo "NAME:                 $NAME"
    echo "OWNER:                $OWNER"
    echo "CONTAINER NAME:       $CTN_NAME"
    echo "IMAGE:                $IMAGE"
    echo "COMMAND:              $COMMAND"
    echo "ENV:                  $ENV"
    echo "MOUNTS:               $MOUNTS"
    echo "HOST PORT:            $HOST_PORT"
    echo "CONTAINER PORT:       $CONTAINER_PORT"
    echo "DOMAIN:               $DOMAIN"
    echo "ROUTE PATH:           $ROUTE_PATH"
    echo "PROXY MODE:           $PROXY_MODE"
    echo "PROXY TARGET:         $PROXY_TARGET"
    echo "AUTO START:           $AUTO_START"
    echo "RESTART POLICY:       $RESTART_POLICY"
    echo "HEALTHCHECK TYPE:     $HEALTHCHECK_TYPE"
    echo "HEALTHCHECK TARGET:   $HEALTHCHECK_TARGET"
    echo "HEALTHCHECK INTERVAL: $HEALTHCHECK_INTERVAL"
    echo "HEALTH STATUS:        $HEALTH_STATUS"
    echo "LAST HEALTH AT:       $LAST_HEALTH_AT"
    echo "CPU ALERT PCT:        $CPU_ALERT_PCT"
    echo "MEM ALERT MB:         $MEM_ALERT_MB"
    echo "NET ALERT MBPS:       $NET_ALERT_MBPS"
    echo "ALERT EMAIL:          $ALERT_EMAIL"
    echo "STATUS:               $STATUS"
    echo "CREATED:              $CREATED"
    echo "UPDATED:              $UPDATED"
}

plain_list() {
    echo -e "$NAME\t$CTN_NAME\t$OWNER\t$IMAGE\t$COMMAND\t$ENV\t$MOUNTS\t$HOST_PORT\t$CONTAINER_PORT\t$DOMAIN\t$ROUTE_PATH\t$PROXY_MODE\t$PROXY_TARGET\t$AUTO_START\t$RESTART_POLICY\t$HEALTHCHECK_TYPE\t$HEALTHCHECK_TARGET\t$HEALTHCHECK_INTERVAL\t$HEALTH_STATUS\t$LAST_HEALTH_AT\t$CPU_ALERT_PCT\t$MEM_ALERT_MB\t$NET_ALERT_MBPS\t$ALERT_EMAIL\t$STATUS\t$CREATED\t$UPDATED"
}

csv_list() {
    echo "NAME,CTN_NAME,OWNER,IMAGE,COMMAND,ENV,MOUNTS,HOST_PORT,CONTAINER_PORT,DOMAIN,ROUTE_PATH,PROXY_MODE,PROXY_TARGET,AUTO_START,RESTART_POLICY,HEALTHCHECK_TYPE,HEALTHCHECK_TARGET,HEALTHCHECK_INTERVAL,HEALTH_STATUS,LAST_HEALTH_AT,CPU_ALERT_PCT,MEM_ALERT_MB,NET_ALERT_MBPS,ALERT_EMAIL,STATUS,CREATED,UPDATED"
    echo "\"$NAME\",\"$CTN_NAME\",\"$OWNER\",\"$IMAGE\",\"$COMMAND\",\"$ENV\",\"$MOUNTS\",\"$HOST_PORT\",\"$CONTAINER_PORT\",\"$DOMAIN\",\"$ROUTE_PATH\",\"$PROXY_MODE\",\"$PROXY_TARGET\",\"$AUTO_START\",\"$RESTART_POLICY\",\"$HEALTHCHECK_TYPE\",\"$HEALTHCHECK_TARGET\",\"$HEALTHCHECK_INTERVAL\",\"$HEALTH_STATUS\",\"$LAST_HEALTH_AT\",\"$CPU_ALERT_PCT\",\"$MEM_ALERT_MB\",\"$NET_ALERT_MBPS\",\"$ALERT_EMAIL\",\"$STATUS\",\"$CREATED\",\"$UPDATED\""
}


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER NAME [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_format_valid "$name" 'container name'


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

vx_docker_load_record "$user" "$name" || check_result "$E_NOTEXIST" "docker container $name doesn't exist"
vx_docker_assert_runtime_labels_match "$user" "$name" "$CTN_NAME"

case "$format" in
    json)  json_list ;;
    plain) plain_list ;;
    csv)   csv_list ;;
    shell) shell_list ;;
    *)     check_result "$E_INVALID" "invalid format :: $format" "$E_INVALID" ;;
esac


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

exit
