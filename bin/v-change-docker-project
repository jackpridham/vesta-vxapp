#!/bin/bash
# info: change Docker Compose project
# options: USER PROJECT COMPOSE_FILE
#
# Persists a new validated revision without applying it.

user=$1
compose_project=$2
compose_file=$3

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi

check_args '3' "$#" 'USER PROJECT COMPOSE_FILE'
[ "$#" -le 3 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
vx_compose_require_project "$user" "$compose_project" \
    || check_result "$E_NOTEXIST" "Compose project does not exist :: $compose_project"

candidate_parent="$(mktemp -d)"
candidate="$candidate_parent/candidate"
trap 'rm -rf -- "$candidate_parent"' EXIT
profile="$(vx_compose_meta_get \
    "$(vx_compose_project_root "$user" "$compose_project")/project.conf" \
    PROFILE)"
vx_compose_prepare_candidate \
    "$user" "$compose_project" "$compose_file" "$candidate" "$profile" \
    || check_result "$E_INVALID" 'Compose project validation failed'
vx_compose_store_revision "$user" "$compose_project" "$candidate" validated \
    || check_result "$E_INVALID" 'Compose project update failed'

log_history "changed Docker Compose project $compose_project"
log_event "$OK" "$ARGUMENTS"
exit
