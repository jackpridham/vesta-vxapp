#!/bin/bash
# info: change domain ssl certificate
# options: USER DOMAIN SSL_DIR [RESTART]
#
# The function changes SSL domain certificate and the key. If ca file present
# it will be replaced as well.


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
ssl_dir=$3
restart=$4

# Includes
source $VESTA/func/main.sh
source $VESTA/func/domain.sh
source $VESTA/func/vx/cloudflare/main.sh
source $VESTA/conf/vesta.conf

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN SSL_DIR [RESTART]'
is_format_valid 'user' 'domain' 'ssl_dir'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
if [ "${VX_CLOUDFLARE_INTERNAL_ORIGIN_SSL:-}" != 1 ] \
    || [ "${VX_CLOUDFLARE_INTERNAL_MIGRATION:-}" != 1 ]; then
    is_object_unsuspended 'user' 'USER' "$user"
fi
is_object_valid 'web' 'DOMAIN' "$domain"
if [ "${VX_CLOUDFLARE_INTERNAL_ORIGIN_SSL:-}" != 1 ] \
    || [ "${VX_CLOUDFLARE_INTERNAL_MIGRATION:-}" != 1 ]; then
    is_object_unsuspended 'web' 'DOMAIN' "$domain"
fi
is_object_value_exist 'web' 'DOMAIN' "$domain" '$SSL'
vx_cf_record_authority_path=$(vx_cf_record_path "$user" "$domain")
vx_cf_certificate_authority_path=$(vx_cf_certificate_path "$user" "$domain")
if { vx_cf_metadata_exists "$user" "$domain" \
        || vx_cf_certificate_metadata_exists "$user" "$domain" \
        || [ -e "$vx_cf_record_authority_path" ] \
        || [ -L "$vx_cf_record_authority_path" ] \
        || [ -e "$vx_cf_certificate_authority_path" ] \
        || [ -L "$vx_cf_certificate_authority_path" ]; } \
    && [ "${VX_CLOUDFLARE_INTERNAL_ORIGIN_SSL:-}" != 1 ]; then
    check_result "$E_FORBIDEN" 'managed web domains use VX Origin SSL'
fi
is_web_domain_cert_valid


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Stage a complete replacement before moving any live file. Keep the existing
# private backup behavior, but include both canonical and rendered copies so a
# failed copy or service restart can restore the exact pre-change files.
ssl_data_dir="$USER_DATA/ssl"
ssl_web_dir="$HOMEDIR/$user/conf/web"
if [ "${VX_CLOUDFLARE_INTERNAL_ORIGIN_SSL:-}" = 1 ]; then
    ssl_staging_root="$VESTA/data/vx/cloudflare/runtime"
    expected_staging_owner="$EUID:$(id -g)"
    [ -d "$ssl_staging_root" ] && [ ! -L "$ssl_staging_root" ] \
        && [ "$(stat -c '%u:%g:%a:%F' "$ssl_staging_root")" \
            = "$expected_staging_owner:700:directory" ] \
        || check_result "$E_UPDATE" 'SSL certificate staging failed'
    tmpdir=$(mktemp -d "$ssl_staging_root/.native-origin-ssl.XXXXXXXX") \
        || check_result "$E_UPDATE" 'SSL certificate staging failed'
else
    tmpdir=$(mktemp -p "$HOMEDIR/$user/web/$domain/private" -d) \
        || check_result "$E_UPDATE" 'SSL certificate staging failed'
fi
stage_dir="$tmpdir/stage"
backup_data_dir="$tmpdir/data"
backup_web_dir="$tmpdir/web"
mkdir -p "$stage_dir" "$backup_data_dir" "$backup_web_dir" \
    || check_result "$E_UPDATE" 'SSL certificate staging failed'
ssl_files_touched=no

finalize_ssl_certificate_staging() {
    local cleanup_result=0

    # VX Origin SSL already owns a separate root-only transactional snapshot.
    # Do not leave that internal staging backup inside the website tree: it
    # changes tenant content and prevents exact migration rollback readback.
    if [ "${VX_CLOUDFLARE_INTERNAL_ORIGIN_SSL:-}" = 1 ]; then
        rm -rf -- "$tmpdir" || cleanup_result=1
    else
        rm -rf -- "$stage_dir" || cleanup_result=1
        chown -R "$user:$user" "$tmpdir" >/dev/null 2>&1 || :
    fi
    return "$cleanup_result"
}

restore_ssl_certificate_files() {
    local restore_result=0

    rm -f "$ssl_data_dir/$domain.ca" "$ssl_data_dir/$domain.crt" \
        "$ssl_data_dir/$domain.key" "$ssl_data_dir/$domain.pem" \
        "$ssl_web_dir/ssl.$domain.ca" "$ssl_web_dir/ssl.$domain.crt" \
        "$ssl_web_dir/ssl.$domain.key" "$ssl_web_dir/ssl.$domain.pem" \
        || restore_result=1
    cp -a "$backup_data_dir/." "$ssl_data_dir/" || restore_result=1
    cp -a "$backup_web_dir/." "$ssl_web_dir/" || restore_result=1
    return "$restore_result"
}

abort_ssl_certificate_change() {
    local result=$1 message=$2

    if [ "$ssl_files_touched" = yes ] \
        && ! restore_ssl_certificate_files; then
        chown -R "$user:$user" "$tmpdir" >/dev/null 2>&1 || :
        check_result "$E_UPDATE" 'SSL certificate rollback failed'
    fi
    finalize_ssl_certificate_staging \
        || check_result "$E_UPDATE" 'SSL certificate staging cleanup failed'
    check_result "$result" "$message"
}

cp -f -- "$ssl_dir/$domain.crt" "$stage_dir/$domain.crt" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate staging failed'
cp -f -- "$ssl_dir/$domain.key" "$stage_dir/$domain.key" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate staging failed'
cp -f -- "$ssl_dir/$domain.crt" "$stage_dir/$domain.pem" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate staging failed'
if [ -e "$ssl_dir/$domain.ca" ]; then
    cp -f -- "$ssl_dir/$domain.ca" "$stage_dir/$domain.ca" \
        || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate staging failed'
    cat "$stage_dir/$domain.ca" >>"$stage_dir/$domain.pem" \
        || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate staging failed'
fi
chmod 660 "$stage_dir/$domain."* \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate staging failed'

shopt -s nullglob
ssl_data_files=("$ssl_data_dir/$domain."*)
ssl_web_files=("$ssl_web_dir/ssl.$domain."*)
shopt -u nullglob
if (( ${#ssl_data_files[@]} > 0 )); then
    cp -a -- "${ssl_data_files[@]}" "$backup_data_dir/" \
        || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate backup failed'
fi
if (( ${#ssl_web_files[@]} > 0 )); then
    cp -a -- "${ssl_web_files[@]}" "$backup_web_dir/" \
        || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate backup failed'
fi
ssl_files_touched=yes
rm -f "$ssl_data_dir/$domain.ca" "$ssl_data_dir/$domain.crt" \
    "$ssl_data_dir/$domain.key" "$ssl_data_dir/$domain.pem" \
    "$ssl_web_dir/ssl.$domain.ca" "$ssl_web_dir/ssl.$domain.crt" \
    "$ssl_web_dir/ssl.$domain.key" "$ssl_web_dir/ssl.$domain.pem" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'

cp -f -- "$stage_dir/$domain.crt" "$ssl_data_dir/$domain.crt" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
cp -f -- "$stage_dir/$domain.key" "$ssl_data_dir/$domain.key" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
cp -f -- "$stage_dir/$domain.pem" "$ssl_data_dir/$domain.pem" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
if [ -e "$stage_dir/$domain.ca" ]; then
    cp -f -- "$stage_dir/$domain.ca" "$ssl_data_dir/$domain.ca" \
        || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
fi
chmod 660 "$ssl_data_dir/$domain."* \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'

cp -f -- "$ssl_data_dir/$domain.crt" "$ssl_web_dir/ssl.$domain.crt" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
cp -f -- "$ssl_data_dir/$domain.key" "$ssl_web_dir/ssl.$domain.key" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
cp -f -- "$ssl_data_dir/$domain.pem" "$ssl_web_dir/ssl.$domain.pem" \
    || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
if [ -e "$ssl_data_dir/$domain.ca" ]; then
    cp -f -- "$ssl_data_dir/$domain.ca" "$ssl_web_dir/ssl.$domain.ca" \
        || abort_ssl_certificate_change "$E_UPDATE" 'SSL certificate install failed'
fi


#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

# Restarting web server
$BIN/v-restart-web $restart
restart_result=$?
if [ "$restart_result" -ne 0 ]; then
    restore_ssl_certificate_files \
        || check_result "$E_UPDATE" 'SSL certificate rollback failed'
    rollback_restart_failed=no
    $BIN/v-restart-web $restart >/dev/null 2>&1 \
        || rollback_restart_failed=yes
    $BIN/v-restart-proxy $restart >/dev/null 2>&1 \
        || rollback_restart_failed=yes
    finalize_ssl_certificate_staging \
        || check_result "$E_UPDATE" 'SSL certificate staging cleanup failed'
    [ "$rollback_restart_failed" = no ] \
        || check_result "$E_RESTART" 'SSL certificate rollback restart failed'
    check_result "$restart_result" "Web restart failed" >/dev/null
fi

$BIN/v-restart-proxy $restart
restart_result=$?
if [ "$restart_result" -ne 0 ]; then
    restore_ssl_certificate_files \
        || check_result "$E_UPDATE" 'SSL certificate rollback failed'
    rollback_restart_failed=no
    $BIN/v-restart-web $restart >/dev/null 2>&1 \
        || rollback_restart_failed=yes
    $BIN/v-restart-proxy $restart >/dev/null 2>&1 \
        || rollback_restart_failed=yes
    finalize_ssl_certificate_staging \
        || check_result "$E_UPDATE" 'SSL certificate staging cleanup failed'
    [ "$rollback_restart_failed" = no ] \
        || check_result "$E_RESTART" 'SSL certificate rollback restart failed'
    check_result "$restart_result" "Proxy restart failed" >/dev/null
fi

finalize_ssl_certificate_staging \
    || check_result "$E_UPDATE" 'SSL certificate staging cleanup failed'

# Logging
log_history "changed ssl certificate for $domain"
log_event "$OK" "$ARGUMENTS"

exit
