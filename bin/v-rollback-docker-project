#!/bin/bash
# info: rollback Docker Compose project to an immutable revision
# options: USER PROJECT [REVISION]

user=$1
compose_project=$2
revision=${3-}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '2' "$#" 'USER PROJECT [REVISION]'
[ "$#" -le 3 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
vx_compose_rollback "$user" "$compose_project" "$revision" \
    || check_result "$E_UPDATE" 'Docker Compose project rollback failed'
log_history "rolled back Docker Compose project $compose_project"
log_event "$OK" "$ARGUMENTS"
exit
