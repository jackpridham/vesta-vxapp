#!/bin/bash
# info: list Docker Compose projects
# options: USER [FORMAT]

user=$1
format=${2-shell}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"
if [ -f "$VESTA/conf/vesta.conf" ]; then
    source "$VESTA/conf/vesta.conf"
fi

check_args '1' "$#" 'USER [FORMAT]'
[ "$#" -le 2 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
projects_json="$(vx_compose_list_json "$user")" \
    || check_result "$E_INVALID" 'unable to list Compose projects'

case "$format" in
    json) printf '%s\n' "$projects_json" ;;
    plain)
        jq -r 'to_entries[] | [.value.OWNER,.value.PROJECT,.key,.value.STATE,.value.PROFILE,(.value.REVISION|tostring),.value.UPDATED] | @tsv' \
            <<<"$projects_json"
        ;;
    shell)
        printf '%s\n' 'OWNER PROJECT COMPOSE_PROJECT STATE PROFILE REVISION UPDATED'
        jq -r 'to_entries[] | [.value.OWNER,.value.PROJECT,.key,.value.STATE,.value.PROFILE,(.value.REVISION|tostring),.value.UPDATED] | @tsv' \
            <<<"$projects_json"
        ;;
    *) check_result "$E_INVALID" "invalid format :: $format" ;;
esac

exit
