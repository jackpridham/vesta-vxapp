#!/bin/bash
# info: consume a validated simple web Docker Compose spec
# options: USER SPEC

user=$1
spec_file=$2

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '2' "$#" 'USER SPEC'
[ "$#" -le 2 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
vx_compose_web_source_validate "$spec_file" simple.spec \
    || check_result "$E_INVALID" 'invalid protected web simple spec'
trap 'vx_compose_web_source_cleanup "$spec_file" >/dev/null 2>&1 || true' EXIT

"$VESTA/bin/v-add-docker-container" "$user" "$spec_file" \
    || check_result "$E_UPDATE" 'web simple Compose project creation failed'

vx_compose_web_source_cleanup "$spec_file" \
    || check_result "$E_UPDATE" 'web simple spec cleanup failed'
trap - EXIT
log_history 'added web simple Docker Compose project'
log_event "$OK" "$ARGUMENTS"
exit
