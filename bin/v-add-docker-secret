#!/bin/bash
# info: add a protected Compose project secret
# options: USER PROJECT NAME VALUE_FILE

user=$1
compose_project=$2
secret_name=$3
value_file=$4

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '4' "$#" 'USER PROJECT NAME VALUE_FILE'
[ "$#" -le 4 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

vx_compose_secret_add "$user" "$compose_project" "$secret_name" "$value_file" \
    || check_result "$E_INVALID" 'Compose secret creation failed'

log_history "added Compose secret $compose_project/$secret_name"
log_event "$OK" "$ARGUMENTS"
exit
