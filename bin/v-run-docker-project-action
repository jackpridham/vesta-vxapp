#!/bin/bash
# info: run an actor-authorized Docker Compose project action
# options: ACTOR USER PROJECT ACTION [ARGUMENT] [ARGUMENT2]

compose_actor=$1
user=$2
compose_project=$3
action=$4
argument=${5-}
argument2=${6-}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '4' "$#" 'ACTOR USER PROJECT ACTION [ARGUMENT] [ARGUMENT2]'
[ "$#" -le 6 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
root="$(vx_compose_project_root "$user" "$compose_project")"
target_revision=0
case "$action" in
    start|stop|restart|recreate|alert-acknowledge) capability=lifecycle ;;
    deploy) capability=deploy ;;
    rollback)
        capability=rollback
        target_revision=$argument
        [[ "$target_revision" =~ ^[1-9][0-9]*$ ]] \
            || check_result "$E_INVALID" 'rollback target revision is invalid'
        ;;
    backup) capability=backup ;;
    restore) capability=restore ;;
    secret-add|secret-change|secret-delete) capability=secret ;;
    *) check_result "$E_INVALID" 'unsupported Compose project action' ;;
esac
vx_compose_authorize "$compose_actor" "$user" "$compose_project" "$capability" \
    || check_result "$E_INVALID" 'Compose project capability denied'
operation_id="$(vx_compose_operation_begin \
    "$root" "$compose_actor" "$action" "$target_revision")" \
    || check_result "$E_UPDATE" 'Compose operation setup failed'
printf 'OPERATION_ID=%s\n' "$operation_id"
vx_compose_operation_update "$root" "$operation_id" authorized 10 \
    'authorization complete' \
    || check_result "$E_UPDATE" 'Compose operation update failed'
printf '%s\n' 'PHASE=authorized PERCENT=10 RESULT=running'
vx_compose_operation_update "$root" "$operation_id" converging 50 \
    'executing authorized action' \
    || check_result "$E_UPDATE" 'Compose operation update failed'
printf '%s\n' 'PHASE=converging PERCENT=50 RESULT=running'

result=1
case "$action" in
    start) vx_compose_start "$user" "$compose_project" && result=0 ;;
    stop) vx_compose_stop "$user" "$compose_project" && result=0 ;;
    restart) vx_compose_restart "$user" "$compose_project" && result=0 ;;
    recreate)
        vx_compose_recreate "$user" "$compose_project" "$argument" && result=0
        ;;
    deploy) vx_compose_deploy "$user" "$compose_project" && result=0 ;;
    rollback)
        vx_compose_rollback "$user" "$compose_project" "$target_revision" \
            && result=0
        ;;
    backup)
        backup_path="$(vx_compose_backup_allocate_path \
            "$user" "$compose_project")" \
            && vx_compose_backup_project \
                "$user" "$compose_project" "$backup_path" \
            && printf '%s\n' "$(basename -- "$backup_path")" \
            && result=0
        ;;
    restore)
        [[ "$argument" == managed:* ]] \
            && backup_path="$(vx_compose_backup_resolve_managed \
                "$user" "$compose_project" "${argument#managed:}")" \
            && vx_compose_restore_project \
                "$user" "$compose_project" "$backup_path" apply \
            && result=0
        ;;
    secret-add)
        vx_compose_secret_add \
            "$user" "$compose_project" "$argument" "$argument2" && result=0
        ;;
    secret-change)
        vx_compose_secret_change \
            "$user" "$compose_project" "$argument" "$argument2" && result=0
        ;;
    secret-delete)
        [[ -z "$argument2" ]] \
            && vx_compose_secret_delete \
                "$user" "$compose_project" "$argument" && result=0
        ;;
    alert-acknowledge)
        [[ -z "$argument2" ]] \
            && vx_compose_alert_acknowledge \
                "$user" "$compose_project" "$argument" && result=0
        ;;
esac
if [[ "$result" -eq 0 ]]; then
    vx_compose_operation_finish "$root" "$operation_id" succeeded \
        'operation completed' \
        || check_result "$E_UPDATE" 'Compose operation evidence failed'
    printf '%s\n' 'PHASE=complete PERCENT=100 RESULT=succeeded'
    log_history "ran authorized Compose action $compose_project/$action"
    log_event "$OK" "$ARGUMENTS"
    exit
fi
vx_compose_operation_finish "$root" "$operation_id" failed \
    'operation failed' || :
printf '%s\n' 'PHASE=failed PERCENT=100 RESULT=failed'
check_result "$E_UPDATE" 'authorized Compose project action failed'
