#!/bin/bash
# info: list Docker Compose project alerts
# options: USER PROJECT [FORMAT]

user=$1
compose_project=$2
format=${3-json}

source "$VESTA/func/main.sh"
source "$VESTA/func/vx/compose/main.sh"

check_args '2' "$#" 'USER PROJECT [FORMAT]'
[ "$#" -le 3 ] || check_result "$E_ARGS" 'too many arguments'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
alerts="$(vx_compose_alerts_list_json "$user" "$compose_project")" \
    || check_result "$E_INVALID" 'Docker Compose alert listing failed'
case "$format" in
    json) printf '%s\n' "$alerts" ;;
    plain)
        jq -r '
            .ALERTS[]
            | [
                (.AID | tostring),
                .TYPE,
                .STATUS,
                (.ACK | tostring),
                .OPENED,
                (.VALUE | tostring)
            ]
            | @tsv
        ' <<<"$alerts"
        ;;
    *) check_result "$E_INVALID" 'format must be json or plain' ;;
esac
exit
